<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowLogger\WindowLogger.csproj" />
    <ProjectReference Include="..\WindowAnalyser\WindowAnalyser.csproj" />
    <ProjectReference Include="..\WindowLoggerConfigGui\WindowLoggerConfigGui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <BundledComponentProject Include="..\WindowLogger\WindowLogger.csproj" />
    <BundledComponentProject Include="..\WindowAnalyser\WindowAnalyser.csproj" />
    <BundledComponentProject Include="..\WindowLoggerConfigGui\WindowLoggerConfigGui.csproj" />
  </ItemGroup>

  <Target Name="CopyBundledComponents"
          AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' == ''">
    <MSBuild Projects="@(BundledComponentProject)"
             Targets="GetWindowLoggerDeploymentFiles"
             Properties="Configuration=$(Configuration);Platform=$(Platform)"
             BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="BundledComponentFile" />
    </MSBuild>
    <Copy SourceFiles="@(BundledComponentFile)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

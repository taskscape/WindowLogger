<Window x:Class="WindowLoggerConfigGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowLogger Control Center"
        Width="1080"
        Height="720"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Config file:" />
            <TextBox x:Name="ConfigPathTextBox" Grid.Column="1" Margin="0,0,8,0" IsReadOnly="True" />
            <Button Grid.Column="2" Margin="0,0,6,0" Padding="14,5" Click="OpenConfig_Click" Content="Open..." />
            <Button Grid.Column="3" Margin="0,0,6,0" Padding="14,5" Click="SaveConfig_Click" Content="Save" />
            <Button Grid.Column="4" Margin="0,0,6,0" Padding="14,5" Click="SaveConfigAs_Click" Content="Save As..." />
            <Button Grid.Column="5" Padding="14,5" Click="ReloadConfig_Click" Content="Reload" />
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="12,0,12,8" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Dashboard">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="14" Background="#FFF3F6FA" CornerRadius="4">
                        <StackPanel>
                            <TextBlock FontSize="14" Foreground="#FF52606D" Text="TRACKING STATUS" />
                            <TextBlock x:Name="TrackingStatusText" Margin="0,4,0,0" FontSize="26" FontWeight="SemiBold" Text="Stopped" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,14,0,14" Orientation="Horizontal">
                        <Button x:Name="StartTrackingButton" Margin="0,0,8,0" Padding="22,8" Click="StartTracking_Click" Content="Start" />
                        <Button x:Name="PauseTrackingButton" Margin="0,0,8,0" Padding="22,8" Click="PauseTracking_Click" Content="Pause" />
                        <Button x:Name="StopTrackingButton" Margin="0,0,8,0" Padding="22,8" Click="StopTracking_Click" Content="Stop" />
                        <Button Margin="16,0,8,0" Padding="22,8" Click="GenerateReport_Click" Content="Generate Report" />
                        <Button Padding="22,8" Click="RefreshDashboard_Click" Content="Refresh" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Text="Recent activity" />
                    <ListBox x:Name="RecentActivityList" Grid.Row="3" FontFamily="Consolas" />
                </Grid>
            </TabItem>
            <TabItem Header="Timeline &amp; Analytics">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" /><ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="0,0,6,0" Padding="11,5" Click="PreviousPeriod_Click" Content="◀" />
                        <Button Grid.Column="1" Margin="0,0,12,0" Padding="11,5" Click="CurrentPeriod_Click" Content="Today" />
                        <Button Grid.Column="2" Margin="0,0,16,0" Padding="11,5" Click="NextPeriod_Click" Content="▶" />
                        <Button x:Name="DayPeriodButton" Grid.Column="3" Margin="0,0,5,0" Padding="13,5" Click="DayPeriod_Click" Content="Day" />
                        <Button x:Name="WeekPeriodButton" Grid.Column="4" Margin="0,0,5,0" Padding="13,5" Click="WeekPeriod_Click" Content="Week" />
                        <Button x:Name="MonthPeriodButton" Grid.Column="5" HorizontalAlignment="Left" Padding="13,5" Click="MonthPeriod_Click" Content="Month" />
                        <TextBox x:Name="AnalyticsSearchText" Grid.Column="6" Margin="10,0,8,0" Padding="6,4" TextChanged="AnalyticsFilter_Changed" ToolTip="Search categories, applications, and window titles" />
                        <ComboBox x:Name="AnalyticsStatusFilter" Grid.Column="7" Padding="6,4" SelectedIndex="0" SelectionChanged="AnalyticsFilter_Changed">
                            <ComboBoxItem Content="All" /><ComboBoxItem Content="Active" /><ComboBoxItem Content="Inactive" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,8,0" Padding="10" Background="#FFEAF4FF" CornerRadius="4">
                            <StackPanel><TextBlock Text="ACTIVE" Foreground="#FF365F85" /><TextBlock x:Name="AnalyticsActiveText" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="0,0,8,0" Padding="10" Background="#FFFFF2D9" CornerRadius="4">
                            <StackPanel><TextBlock Text="IDLE" Foreground="#FF87652D" /><TextBlock x:Name="AnalyticsIdleText" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Margin="0,0,8,0" Padding="10" Background="#FFF3F6FA" CornerRadius="4">
                            <StackPanel><TextBlock Text="PREVIOUS PERIOD" Foreground="#FF52606D" /><TextBlock x:Name="AnalyticsPreviousText" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                        <Border Grid.Column="3" Padding="10" Background="#FFEDF8EE" CornerRadius="4">
                            <StackPanel><TextBlock Text="CHANGE" Foreground="#FF44704A" /><TextBlock x:Name="AnalyticsChangeText" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="76" /></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock x:Name="AnalyticsPeriodText" FontSize="16" FontWeight="SemiBold" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Rectangle Width="12" Height="12" Margin="0,0,4,0" Fill="#FF4385D0" /><TextBlock Margin="0,0,14,0" Text="Active" />
                                <Rectangle Width="12" Height="12" Margin="0,0,4,0" Fill="#FFE0A23A" /><TextBlock Text="Idle" />
                            </StackPanel>
                        </DockPanel>
                        <Border Grid.Row="1" BorderBrush="#FFD6DEE7" BorderThickness="1" Background="#FFFAFBFC">
                            <Canvas x:Name="TimelineCanvas" ClipToBounds="True" SizeChanged="TimelineCanvas_SizeChanged" />
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="3" Margin="0,0,0,6" Foreground="#FF52606D" Text="Select a category, then an application, to drill down to window titles." />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Margin="0,0,8,0" Header="Categories">
                            <ListBox x:Name="CategoryChartList" SelectionChanged="CategoryChartList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3">
                                            <DockPanel LastChildFill="False"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" /></DockPanel>
                                            <Grid Height="8" Margin="0,4,0,0" Background="#FFE8EDF2"><Rectangle HorizontalAlignment="Left" Width="{Binding BarWidth}" Fill="#FF6B8FD6" /></Grid>
                                            <TextBlock FontSize="11" Foreground="#FF647384" Text="{Binding Comparison}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Margin="0,0,8,0" Header="Applications">
                            <ListBox x:Name="ApplicationChartList" SelectionChanged="ApplicationChartList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3">
                                            <DockPanel LastChildFill="False"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" /></DockPanel>
                                            <Grid Height="8" Margin="0,4,0,0" Background="#FFE8EDF2"><Rectangle HorizontalAlignment="Left" Width="{Binding BarWidth}" Fill="#FF56A68B" /></Grid>
                                            <TextBlock FontSize="11" Foreground="#FF647384" Text="{Binding Comparison}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="Window titles">
                            <ListBox x:Name="WindowTitleList" />
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="RuleTesterTab" Header="Rule Tester">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Margin="0,7" Text="Window title" />
                        <TextBox x:Name="RuleWindowTitleText" Grid.Column="1" Margin="0,3,12,3" Padding="5" TextChanged="RuleTesterInput_Changed" />
                        <TextBlock Grid.Column="2" Margin="0,7" Text="Executable" />
                        <TextBox x:Name="RuleExecutableText" Grid.Column="3" Margin="0,3" Padding="5" TextChanged="RuleTesterInput_Changed" />
                        <TextBlock Grid.Row="1" Margin="0,7" Text="Recent activity" />
                        <ComboBox x:Name="RecentRuleSamples" Grid.Row="1" Grid.Column="1" Margin="0,3,12,3" SelectionChanged="RecentRuleSamples_SelectionChanged" />
                        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <Button Margin="0,3,8,3" Padding="14,5" Click="TestRules_Click" Content="Test Rules" />
                            <CheckBox x:Name="LiveRulePreviewCheck" Margin="0,0,8,0" VerticalAlignment="Center" IsChecked="True" Checked="LiveRulePreview_Changed" Unchecked="LiveRulePreview_Changed" Content="Live preview" />
                            <Button Margin="0,3,8,3" Padding="12,5" Click="CreateRuleFromSample_Click" Content="Create Rule" />
                            <Button Margin="0,3" Padding="12,5" Click="CopyCapturedValue_Click" Content="Copy Value" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,10,0,8" Padding="10" Background="#FFF3F6FA" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CapturedPreviewText" FontFamily="Consolas" Foreground="#FF52606D" />
                                <TextBlock x:Name="RuleOutcomeText" Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="RuleCategoriesText" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="OpenMatchedApplicationButton" Margin="0,0,8,0" Padding="12,5" Click="OpenMatchedApplication_Click" Content="Open Application" />
                                <Button x:Name="OpenMatchedCategoryButton" Padding="12,5" Click="OpenMatchedCategory_Click" Content="Open Category" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                        <GroupBox Margin="0,0,8,0" Header="Evaluation trace">
                            <ListBox x:Name="RuleTraceList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Heading}" />
                                            <TextBlock Foreground="#FF52606D" Text="{Binding Patterns}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Warnings">
                            <ListBox x:Name="RuleWarningsList" />
                        </GroupBox>
                    </Grid>

                    <DockPanel Grid.Row="3" Margin="0,10,0,6">
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="Saved regression cases" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Margin="0,0,6,0" Padding="12,5" Click="AddRuleTest_Click" Content="Add Current" />
                            <Button Margin="0,0,6,0" Padding="12,5" Click="RemoveRuleTest_Click" Content="Remove" />
                            <Button Padding="12,5" Click="RunRuleTests_Click" Content="Run All" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="RuleTestsGrid" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" CellEditEnding="RuleTestsGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="120" Header="Name" Binding="{Binding Name}" />
                            <DataGridTextColumn Width="2*" Header="Window title" Binding="{Binding WindowTitle}" />
                            <DataGridTextColumn Width="120" Header="Executable" Binding="{Binding ExecutableName}" />
                            <DataGridTextColumn Width="130" Header="Expected app" Binding="{Binding ExpectedApplication}" />
                            <DataGridTextColumn Width="160" Header="Expected categories" Binding="{Binding ExpectedCategories}" />
                            <DataGridCheckBoxColumn Width="80" Header="Excluded" Binding="{Binding ExpectedExcluded}" />
                            <DataGridTextColumn Width="170" Header="Last result" IsReadOnly="True" Binding="{Binding LastResult}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem x:Name="ApplicationsTab" Header="Applications">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="260" />
                        <ColumnDefinition Width="3*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox x:Name="ApplicationsList" SelectionChanged="ApplicationsList_SelectionChanged" />
                        <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Margin="0,0,6,0" Padding="12,5" Click="MoveApplicationUp_Click" Content="Move Up" />
                            <Button Padding="12,5" Click="MoveApplicationDown_Click" Content="Move Down" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,12,8" Text="Name" />
                        <TextBox x:Name="AppNameText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,12,8" Text="Include&#x0a;(one per line)" />
                        <TextBox x:Name="AppIncludeText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,12,8" Text="Exclude&#x0a;(one per line)" />
                        <TextBox x:Name="AppExcludeText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />

                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,6,0" Padding="12,5" Click="AddApplication_Click" Content="Add New" />
                            <Button Margin="0,0,6,0" Padding="12,5" Click="UpdateApplication_Click" Content="Update Selected" />
                            <Button Padding="12,5" Click="RemoveApplication_Click" Content="Remove Selected" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Exclusions">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="260" />
                        <ColumnDefinition Width="3*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="ExclusionsList" Grid.Column="0" Margin="0,0,12,0"
                             SelectionChanged="ExclusionsList_SelectionChanged" />

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Margin="0,6,12,8" Text="Include&#x0a;(one per line)" />
                        <TextBox x:Name="ExclusionIncludeText" Grid.Column="1" Margin="0,0,0,8"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,6,0" Padding="12,5" Click="AddExclusion_Click" Content="Add New" />
                            <Button Margin="0,0,6,0" Padding="12,5" Click="UpdateExclusion_Click" Content="Update Selected" />
                            <Button Padding="12,5" Click="RemoveExclusion_Click" Content="Remove Selected" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="CategoriesTab" Header="Categories">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="260" />
                        <ColumnDefinition Width="3*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="CategoriesList" Grid.Column="0" Margin="0,0,12,0"
                             SelectionChanged="CategoriesList_SelectionChanged" />

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,12,8" Text="Name" />
                        <TextBox x:Name="CategoryNameText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,12,8" Text="Include applications&#x0a;(one per line)" />
                        <TextBox x:Name="CategoryIncludeText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,12,8" Text="Exclude applications&#x0a;(one per line)" />
                        <TextBox x:Name="CategoryExcludeText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />

                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,6,0" Padding="12,5" Click="AddCategory_Click" Content="Add New" />
                            <Button Margin="0,0,6,0" Padding="12,5" Click="UpdateCategory_Click" Content="Update Selected" />
                            <Button Padding="12,5" Click="RemoveCategory_Click" Content="Remove Selected" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Diagnostics">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <Button Padding="16,6" Click="RunDiagnostics_Click" Content="Run Diagnostics" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Checks rule ordering, duplicates, conflicts, categories, and observed activity." />
                    </StackPanel>
                    <ListBox x:Name="DiagnosticsList" Grid.Row="1" />
                </Grid>
            </TabItem>
            <TabItem Header="Privacy &amp; Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16" MaxWidth="760" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="0,7" Text="Inactivity threshold (seconds)" />
                        <TextBox x:Name="InactivitySecondsText" Grid.Row="0" Grid.Column="1" Margin="0,4" />
                        <TextBlock Grid.Row="1" Margin="0,7" Text="Polling interval (milliseconds)" />
                        <TextBox x:Name="PollingMillisecondsText" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                        <TextBlock Grid.Row="2" Margin="0,7" Text="Retention period (days, 0 = unlimited)" />
                        <TextBox x:Name="RetentionDaysText" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                        <TextBlock Grid.Row="3" Margin="0,7" Text="Crash recovery cap (minutes)" />
                        <TextBox x:Name="CrashRecoveryMinutesText" Grid.Row="3" Grid.Column="1" Margin="0,4" />
                        <TextBlock Grid.Row="4" Margin="0,7" Text="Report folder" />
                        <TextBox x:Name="ReportFolderText" Grid.Row="4" Grid.Column="1" Margin="0,4" />
                        <CheckBox x:Name="StoreWindowTitlesCheck" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8" Content="Store foreground window titles (disable for privacy)" />
                        <CheckBox x:Name="StartPausedCheck" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,8" Content="Start tracking paused" />
                        <CheckBox x:Name="StartTrackingOnLaunchCheck" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,8" Content="Start tracking when the control center opens" />
                        <CheckBox x:Name="LaunchAtStartupCheck" Grid.Row="8" Grid.ColumnSpan="2" Margin="0,8" Content="Launch WindowLogger Control Center when I sign in" />
                        <Button Grid.Row="9" Grid.ColumnSpan="2" Margin="0,16,0,0" Padding="18,7" HorizontalAlignment="Left" Click="SaveUserSettings_Click" Content="Save Privacy &amp; Settings" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <TextBlock x:Name="StatusText" Text="Ready" />
        </StatusBar>
    </Grid>
</Window>
